# --- Web client (apps/web) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# --- Edge Functions (supabase functions serve --env-file .env.local) ---------
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase runtime. Locally, `supabase status` prints them.
# Direct Postgres connection for transactional writes (never ship to a client).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Local tests (packages/server) -------------------------------------------
# A plain Postgres 15+ the tests may reset. Defaults to the value below.
KATAN_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/katan_test
